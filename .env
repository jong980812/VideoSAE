# Data roots. Edit these to point at your own copies of the data.
#
# A clip list (datafile/*.json) names each clip by a key; the clip
# is <root>/<key>, either a directory of frames (000001.jpg ...) or a video file
# (<root>/<key>, or <root>/<key>.mp4 for Kinetics). Kinetics keys are
# <class>/<clip_id> (class names with spaces, e.g. "air drumming"; clip ids as in
# the CVDF release). config/datasets/<name>.yaml says which root each dataset uses.
#
# Scripts use these as the defaults of --data_root / --train_root / --val_root.
# A command-line flag wins, then an environment variable of the same name, then this file.

# Kinetics-400 train: SAE activations (extract_activations.py), probe fitting (train_probe.py)
K400_TRAIN=/n/fs/visualai-scr/Data/Kinetics_cvf/frames/train

# Kinetics-400 val: evaluation (evaluate.py), probe epoch selection (train_probe.py),
# and the person layer of the HAT composites
K400_VAL=/n/fs/visualai-scr/Data/Kinetics_cvf/frames_highres/val

# NTU RGB+D: flat, one entry per clip, S001C001P001R001A001_rgb.avi (frame dir or video)
NTU_ROOT=/n/fs/visualai-scr/Data/nturgbd/rgb_10fps_shortside224

# HAT4 (val release): holds seg/<class>/<clip_id>/ (soft person masks) and
# inpaint/<class>/<clip_id>/ (person removed); the person frames come from K400_VAL
HAT4_ROOT=/n/fs/visualai-scr/Data/HAT4

# Something-Something v2: flat, one entry per clip, <id>.webm (frame dir or video)
SSV2_ROOT=/n/fs/visualai-scr/Data/SomethingSomething/rgb_10fps_shortside224
